; HTAdmin config file.
; Important: secure this file from access
; Rename to config.ini!
[application]
; Change this to customize your title:
app_title = HTAdmin

; Path to html files which have to be secured: 
secure_path  = /app/

; Use metadata (necessary e.g. for password reset via mail):
use_metadata = true

; Default password = admin
; Change this for live!
admin_user = admin
admin_pwd_hash = "$2y$12$4gNYaJ1WFg2.dbgUOW2tn.rjkZtKUH3SLBx8kB.LNrzr6fkpMA8yy"

; Password reset mail via smtp:
mail_from = "sometest@something.de"
mail_user = "sometest@something.de"
; Use smtp if you set the mail_server, otherwise use sendmail.
mail_server = "mailserver.de"
mail_pwd  = "secret-password"

